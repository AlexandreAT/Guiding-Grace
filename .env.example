# Copie para .env.local e ajuste. Nenhum valor aqui é secreto: vai para o bundle do navegador.
# URL do Worker do Gideon (vazio = chat só com o motor local, sem IA)
VITE_GIDEON_API_URL=http://localhost:8787
# Site Key do Turnstile (pública). Local: chave de TESTE da Cloudflare, que só passa com a secret de teste
# do worker/.dev.vars. Produção: a Site Key do widget criado no painel, cadastrada no Netlify
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
